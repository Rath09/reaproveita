# Copie para .env e ajuste. Sem .env o front roda 100% no mock em memória.

# URL do back-end FastAPI (sem /api no final — o cliente acrescenta)
VITE_API_URL=http://localhost:8000

# true = api.js chama a API real; false ou ausente = mock (útil enquanto o back não cobre o contrato)
VITE_USE_API=false

# true = força 100% mock, ignorando USAR_API e FUNCOES_REAIS (demo pública sem back no ar,
# ex.: painel de transparência hospedado sozinho). Tela de login mostra os usuários de demo.
VITE_FORCE_MOCK=false
