# Copie para .env e ajuste. Sem .env o front roda 100% no mock em memória.

# URL do back-end FastAPI (sem /api no final — o cliente acrescenta)
VITE_API_URL=http://localhost:8000

# true = api.js chama a API real; false ou ausente = mock (útil enquanto o back não cobre o contrato)
VITE_USE_API=false
